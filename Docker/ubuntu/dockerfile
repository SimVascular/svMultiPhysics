COPY --from=buildhypre /hypre-install /hypre/
COPY --from=buildtrilinos /trilinos /trilinos
COPY --from=buildpetsc /petsc-install /petsc
COPY --from=buildgtest /google /google  
COPY --from=buildlapack /lapack-source-commit /source-revisions/lapack
COPY --from=buildhdf5 /hdf5-source-commit /source-revisions/hdf5
COPY --from=buildhypre /hypre-source-commit /source-revisions/hypre
COPY --from=buildtrilinos /trilinos-source-commit /source-revisions/trilinos
COPY --from=buildpetsc /petsc-source-commit /source-revisions/petsc
COPY --from=buildgtest /gtest-source-commit /source-revisions/googletest

# ================================================================================
# CONDA
ENV CONDA_DIR=/conda

# Conda environment depending on architecture
ARG MINICONDA_SHA256=76cf791877078e74410f64e5c2ef7da4e217fd7a433c2c3674c9d9695225c3bb
RUN wget https://repo.anaconda.com/miniconda/Miniconda3-py314_26.9.4-1-Linux-x86_64.sh -O /miniconda.sh && \
    echo "${MINICONDA_SHA256}  /miniconda.sh" | sha256sum -c - && \
    /bin/bash /miniconda.sh -b -p $CONDA_DIR

ENV PATH="${CONDA_DIR}/bin:${PATH}"

# Create Conda environment
RUN conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main && \
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r
    
# Python 3.14 with meshio failed to read an integration-test VTU file (Base64
# padding error); the same tests passed with Python 3.12.
RUN conda create -y -n svmultiphysics python=3.12 pip && \
    conda run -n svmultiphysics python -m pip install pytest pytest-cov pytest-mock numpy meshio pandas

COPY report-dependency-versions.sh /usr/local/bin/report-dependency-versions
RUN chmod +x /usr/local/bin/report-dependency-versions && \
    mkdir -p /usr/local/share/svMultiPhysics && \
    /usr/local/bin/report-dependency-versions > /usr/local/share/svMultiPhysics/dependency-versions.txt
# Set libraries environment
ENV PATH="/google:/vtk:/openmpi/bin:/cmake/bin:/trilinos/lib/cmake/Trilinos:${PATH}"
ENV LD_LIBRARY_PATH="/openmpi/lib:/petsc/lib:/lapack"

ENV OMPI_ALLOW_RUN_AS_ROOT=1
ENV OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1
