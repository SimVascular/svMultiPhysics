# ================================================================================
# TRILINOS
# ================================================================================

# Use a base image for building tools and dependencise
FROM base AS buildtrilinos

# Copy all dependencies and set ENV
COPY --from=buildcmake /cmake /cmake
COPY --from=buildompi /openmpi /openmpi
COPY --from=buildboost /boost /boost
COPY --from=buildhdf5 /hdf5 /hdf5
COPY --from=buildlapack /tmp/lapack /lapack
COPY --from=buildhypre /hypre-install /hypre/

ENV PATH="/cmake/bin:/openmpi/bin:${PATH}"

# Make sure python3 is the default python
RUN ln -s /usr/bin/python3 /usr/bin/python

# Setting hypre installation directory
ARG TRILINOS_INSTALL_DIR=/trilinos
ARG TRILINOS_COMMIT=01c06c6958dde35fd8a4151e95020c3a9e33d770

# Create new user
RUN useradd -ms /bin/bash luser

# ================================================================================
# Download, extract, install
RUN git clone https://github.com/trilinos/Trilinos.git && \
    git -C /Trilinos checkout --detach ${TRILINOS_COMMIT} && \
    git -C /Trilinos rev-parse HEAD > /trilinos-source-commit
WORKDIR /Trilinos/build

# Build trilinos
#-DTPL_ENABLE_MUMPS=ON \
# ShyLU_NodeTacho enables the external gtest TPL even with Trilinos Gtest off.
# This stage has no gtest libraries, so disable the TPL (and ShyLU_NodeTacho).
RUN cmake \
-DCMAKE_BUILD_TYPE=${DEPENDENCY_BUILD_TYPE} \
-DCMAKE_INSTALL_PREFIX=${TRILINOS_INSTALL_DIR} \
-DTPL_ENABLE_MPI=ON \
-DTPL_ENABLE_Boost=ON \
-DBoost_LIBRARY_DIRS=/boost/lib \
-DBoost_INCLUDE_DIRS=/boost/include \
-DTPL_ENABLE_BLAS=ON \
-DBLAS_LIBRARY_DIRS=/lapack \
-DTPL_ENABLE_HDF5=ON \
-DHDF5_LIBRARY_DIRS=/hdf5/lib \
-DHDF5_INCLUDE_DIRS=/hdf5/include \ 
-DTPL_ENABLE_HYPRE=ON \
-DHYPRE_LIBRARY_DIRS=/hypre/lib \
-DHYPRE_INCLUDE_DIRS=/hypre/include \
-DTPL_ENABLE_LAPACK=ON \
-DLAPACK_LIBRARY_DIRS=/lapack \
-DCMAKE_C_COMPILER=/openmpi/bin/mpicc \
-DCMAKE_CXX_COMPILER=/openmpi/bin/mpicxx \
-DCMAKE_Fortran_COMPILER=/openmpi/bin/mpif90 \
-DTrilinos_ENABLE_MueLu=ON \
-DTrilinos_ENABLE_ROL=ON \
-DTrilinos_ENABLE_Sacado=ON \
-DTrilinos_ENABLE_Teuchos=ON \
-DTrilinos_ENABLE_Zoltan=ON \
-DTrilinos_ENABLE_Tpetra=ON \
-DTrilinos_ENABLE_Belos=ON \
-DTrilinos_ENABLE_Ifpack2=ON \
-DTrilinos_ENABLE_Amesos2=ON \
-DTrilinos_ENABLE_Zoltan2=ON \
-DTrilinos_ENABLE_Kokkos=ON \
-DKokkos_ENABLE_SERIAL=ON \
-DTrilinos_ENABLE_KokkosKernels=ON \
-DTrilinos_ENABLE_Xpetra=ON \
-DXpetra_ENABLE_Kokkos_compat=ON \
-DTrilinos_ENABLE_EXPLICIT_INSTANTIATION=ON \
-DTpetra_INST_SERIAL=ON \
-DTpetra_INST_DOUBLE=ON \
-DTpetra_INST_INT_INT=ON \
-DMueLu_ENABLE_EXPLICIT_INSTANTIATION=ON \
-DTrilinos_ENABLE_Gtest=OFF \
-DTPL_ENABLE_gtest=OFF /Trilinos && \
make -j6 install

# Cleanup
WORKDIR /
RUN rm -rf Trilinos


# ================================================================================
# PETSC
# ================================================================================

# Use a base image for building tools and dependencise
FROM base AS buildpetsc

# Copy all dependencies and set ENV
COPY --from=buildcmake /cmake /cmake
COPY --from=buildompi /openmpi /openmpi
COPY --from=buildboost /boost /boost
COPY --from=buildhdf5 /hdf5 /hdf5
COPY --from=buildlapack /tmp/lapack /lapack
COPY --from=buildhypre /hypre-install /hypre/

ENV PATH="/cmake/bin:${PATH}"

# Make sure python3 is the default python
RUN ln -s /usr/bin/python3 /usr/bin/python

# Setting petsc installation directory
ARG PETSC_INSTALL_DIR=/petsc-install
ARG PETSC_TAG=v3.26.1

# Create new user
RUN useradd -ms /bin/bash luser

# ================================================================================
# Download and install
RUN git clone --depth 1 --branch ${PETSC_TAG} https://gitlab.com/petsc/petsc.git && \
    git -C /petsc rev-parse HEAD > /petsc-source-commit

# Set permission for luser
RUN chown -R luser:luser /petsc

RUN mkdir ${PETSC_INSTALL_DIR} && \
    chown -R luser:luser ${PETSC_INSTALL_DIR}

# Switch user (petsc should be installed by non-root)
USER luser

WORKDIR /petsc

# Install petsc library in $PETSC_INSTALL_DIR 
# Libraries path must be set explicitly
# Release and RelWithDebInfo intentionally share optimized PETSc flags; only
# Release dependency images are eligible for rc/final promotion.
RUN if [ "${DEPENDENCY_BUILD_TYPE}" = "Debug" ]; then \
        petsc_debugging=1; petsc_flags='-g -O0'; petsc_arch=arch-linux-c-debug; \
    else \
        petsc_debugging=0; petsc_flags='-g -O2'; petsc_arch=arch-linux-c-opt; \
    fi && \
PETSC_ARCH="${petsc_arch}" ./configure --prefix=$PETSC_INSTALL_DIR \
--with-debugging=${petsc_debugging} \
--with-precision=double \
--download-suitesparse \
--download-mumps \
--download-superlu \
--download-superlu_dist \
--download-ml \
--download-eigen \
--download-hypre \
--with-mpi-dir=/openmpi \
--with-blas-lib=/lapack/libblas.so \
--with-lapack-lib=/lapack/liblapack.so \
--download-scalapack \
--download-metis \
--download-parmetis \
--with-strict-petscerrorcode \
--with-mpi-compilers=1 \
COPTFLAGS="${petsc_flags}" \
FOPTFLAGS="${petsc_flags}" \
CXXOPTFLAGS="${petsc_flags}" && \
make PETSC_DIR=/petsc PETSC_ARCH="${petsc_arch}" all && \
make PETSC_DIR=/petsc PETSC_ARCH="${petsc_arch}" install && \
make PETSC_DIR=$PETSC_INSTALL_DIR PETSC_ARCH="" check

# Cleanup
USER root
WORKDIR /
RUN rm -rf /petsc

# ================================================================================
# GOOGLE TEST
# ================================================================================
# Use a base image for building tools and dependencise
FROM base AS buildgtest

# Copy all dependencies and set ENV
COPY --from=buildcmake /cmake /cmake
COPY --from=buildompi /openmpi /openmpi

ENV PATH="/cmake/bin:/openmpi/bin:${PATH}"

# ================================================================================
# GTEST
ARG GTEST_TAG=v1.14.0
RUN git clone --depth 1 --branch ${GTEST_TAG} https://github.com/google/googletest.git && \
    git -C /googletest rev-parse HEAD > /gtest-source-commit
WORKDIR /googletest
RUN mkdir build    && \
    cd build       && \
    cmake .. -DBUILD_SHARED_LIBS=ON -DBUILD_GMOCK=OFF -DCMAKE_BUILD_TYPE=${DEPENDENCY_BUILD_TYPE} -DCMAKE_INSTALL_PREFIX=/google && \
    make && \
    make install

# Clenup
WORKDIR /
RUN rm -rf /googletest

