# ================================================================================
# BASE: Common base image with dependencies
# ================================================================================
ARG UBUNTU_BASE_IMAGE=ubuntu:26.04
FROM ${UBUNTU_BASE_IMAGE} AS base

ARG UBUNTU_BASE_IMAGE
ENV UBUNTU_BASE_IMAGE=${UBUNTU_BASE_IMAGE}
ARG DEPENDENCY_BUILD_TYPE=Release
ENV DEPENDENCY_BUILD_TYPE=${DEPENDENCY_BUILD_TYPE}
RUN case "${DEPENDENCY_BUILD_TYPE}" in \
        Release|RelWithDebInfo|Debug) ;; \
        *) echo "Unsupported DEPENDENCY_BUILD_TYPE=${DEPENDENCY_BUILD_TYPE}" >&2; exit 1 ;; \
    esac

# Any debian-based command will not prompt user-input
ENV DEBIAN_FRONTEND=noninteractive

# Install essentials tools
RUN apt-get update && \
    apt-get install -y \
    build-essential wget git vim \
    python3 gfortran default-jdk default-jre \
    libglu1-mesa-dev freeglut3-dev mesa-common-dev \ 
    openssl libssl-dev zlib1g-dev libicu-dev libglvnd-dev lcov git-lfs curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# GNU tar fails with "Function not implemented" under arm64-to-amd64 emulation;
# use bsdtar only in stages that extract archives.
FROM base AS tar-emulation-compat
ARG BUILDARCH
ARG TARGETARCH
RUN if [ "${BUILDARCH}/${TARGETARCH}" = "arm64/amd64" ]; then \
        apt-get update && \
        apt-get install -y --no-install-recommends libarchive-tools && \
        ln -s /usr/bin/bsdtar /usr/local/bin/tar && \
        rm -rf /var/lib/apt/lists/*; \
    fi

# ================================================================================
# CMAKE
# ================================================================================
# Use a base image for building tools and dependencise
FROM tar-emulation-compat AS buildcmake

# Setting CMake version CMake installation directory
ARG CMAKE_VERSION=3.29.0
ARG CMAKE_INSTALL_DIR=/cmake

# Create new user
RUN useradd -ms /bin/bash luser

# ================================================================================
# Install Kitware's x86-64 binary instead of compiling CMake under emulation.
RUN mkdir -p ${CMAKE_INSTALL_DIR} && \
    wget https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz -O /tmp/cmake.tar.gz && \
    tar -xzf /tmp/cmake.tar.gz -C ${CMAKE_INSTALL_DIR} --strip-components=1 && \
    ${CMAKE_INSTALL_DIR}/bin/cmake --version && \
    rm /tmp/cmake.tar.gz

# ================================================================================
# OPENMPI
# ================================================================================
# Use a base image for building tools and dependencise
FROM tar-emulation-compat AS buildompi

# Copy cmake binary from buildcmake 
COPY --from=buildcmake /cmake /cmake

# Setting OMPI version OMPI installation directory
ARG OMPI_VERSION=5.0.5
ARG OMPI_INSTALL_DIR=/openmpi

# Create new user
RUN useradd -ms /bin/bash luser

# ================================================================================
# Download, extract, install
RUN wget https://download.open-mpi.org/release/open-mpi/v5.0/openmpi-${OMPI_VERSION}.tar.gz && \
    tar -xzf openmpi-${OMPI_VERSION}.tar.gz && \
    rm openmpi-${OMPI_VERSION}.tar.gz

WORKDIR /openmpi-${OMPI_VERSION}
# Open MPI also uses tar when unpacking bundled dependencies during configure.
RUN ./configure --with-pmix --with-slurm --prefix=${OMPI_INSTALL_DIR} && \
    make -j6 all && \
    make install 

# Cleanup
WORKDIR / 
RUN rm -rf /openmpi-${OMPI_VERSION}

# ================================================================================
# VTK
# ================================================================================
# Use a base image for building tools and dependencise
FROM tar-emulation-compat AS buildvtk

# Copy cmake binary from buildcmake and set ENV
COPY --from=buildcmake /cmake /cmake 

ENV PATH="/cmake/bin:${PATH}"

# Setting VTK  version VTK installation directory
ARG VTK_VERSION=9.3.1
ARG VTK_INSTALL_DIR=/vtk

# Create new user
RUN useradd -ms /bin/bash luser

# ================================================================================
# Download, extract, install
RUN wget https://www.vtk.org/files/release/9.3/VTK-${VTK_VERSION}.tar.gz && \
    tar -xzf VTK-${VTK_VERSION}.tar.gz && \
    rm VTK-${VTK_VERSION}.tar.gz

WORKDIR /build-vtk
RUN cmake -DBUILD_SHARED_LIBS:BOOL=OFF \
-DCMAKE_BUILD_TYPE:STRING=${DEPENDENCY_BUILD_TYPE} \
-DBUILD_EXAMPLES=OFF \
-DBUILD_TESTING=OFF \
-DVTK_USE_SYSTEM_EXPAT:BOOL=ON \
-DVTK_USE_SYSTEM_ZLIB:BOOL=ON \
-DVTK_LEGACY_REMOVE=ON \
-DVTK_Group_Rendering=OFF \
-DVTK_Group_StandAlone=OFF \
-DVTK_RENDERING_BACKEND=None \
-DVTK_WRAP_PYTHON=OFF \
-DModule_vtkChartsCore=ON \
-DModule_vtkCommonCore=ON \
-DModule_vtkCommonDataModel=ON \
-DModule_vtkCommonExecutionModel=ON \
-DModule_vtkFiltersCore=ON \
-DModule_vtkFiltersFlowPaths=ON \
-DModule_vtkFiltersModeling=ON \
-DModule_vtkIOLegacy=ON \
-DModule_vtkIOXML=ON \
-DVTK_GROUP_ENABLE_Views=NO \
-DVTK_GROUP_ENABLE_Web=NO \
-DVTK_GROUP_ENABLE_Imaging=NO \
-DVTK_GROUP_ENABLE_Qt=DONT_WANT \
-DVTK_GROUP_ENABLE_Rendering=DONT_WANT \
-DCMAKE_INSTALL_PREFIX=${VTK_INSTALL_DIR} /VTK-${VTK_VERSION} && \
    cmake --build . --parallel 4 && \
    make install

# Cleanup
WORKDIR / 
RUN rm -rf /VTK-${VTK_VERSION} build-vtk

# ================================================================================
# BOOST
# ================================================================================
# Use a base image for building tools and dependencise
FROM tar-emulation-compat AS buildboost

# Copy cmake binary from buildcmake and set ENV
COPY --from=buildcmake /cmake /cmake 

ENV PATH="/cmake/bin:${PATH}"

# Setting Boost version Boost installation directory
ARG BOOST_VERSION=1_89_0
ARG BOOST_INSTALL_DIR=/boost

# Create new user
RUN useradd -ms /bin/bash luser

# ================================================================================
# Download, extract, install
RUN wget https://archives.boost.io/release/1.89.0/source/boost_${BOOST_VERSION}.tar.gz && \
    tar -xzf boost_${BOOST_VERSION}.tar.gz && \
    rm boost_${BOOST_VERSION}.tar.gz

WORKDIR /boost_${BOOST_VERSION}
RUN ./bootstrap.sh --prefix=${BOOST_INSTALL_DIR} && \
    if [ "${DEPENDENCY_BUILD_TYPE}" = "Debug" ]; then variant=debug; else variant=release; fi && \
    ./b2 install variant=${variant}

# Cleanup
WORKDIR / 
RUN rm -rf /boost_${BOOST_VERSION}

# ================================================================================
# LAPACK
# ================================================================================
# Use a base image for building tools and dependencise
FROM base AS buildlapack

# Copy cmake binary from buildcmake and set ENV
COPY --from=buildcmake /cmake /cmake 
ENV PATH="/cmake/bin:${PATH}"

# Setting lapack installation directory
ARG LAPACK_INSTALL_DIR=/tmp/lapack
ARG LAPACK_TAG=v3.12.1

# Create new user
RUN useradd -ms /bin/bash luser

# ================================================================================
# Download, extract, install
RUN git clone --depth 1 --branch ${LAPACK_TAG} https://github.com/Reference-LAPACK/lapack.git && \
    git -C /lapack rev-parse HEAD > /lapack-source-commit
WORKDIR /build
RUN cmake -DBUILD_SHARED_LIBS=ON -DCMAKE_BUILD_TYPE=${DEPENDENCY_BUILD_TYPE} -DCMAKE_INSTALL_LIBDIR=${LAPACK_INSTALL_DIR} ../lapack && \
    cmake --build . -j6 --target install

# Cleanup
WORKDIR / 
RUN rm -rf /build /lapack

# ================================================================================
# HDF5
# ================================================================================
# Use a base image for building tools and dependencise
FROM base AS buildhdf5

# Copy cmake binary from buildcmake and set ENV
COPY --from=buildcmake /cmake /cmake
COPY --from=buildompi /openmpi /openmpi/

ENV PATH="/cmake/bin:/openmpi:${PATH}"

# Setting hdf5 installation directories
ARG HDF5_INSTALL_DIR=/hdf5
ARG HDF5_COMMIT=55e183236ff2591e0f8cd5e3c081e0666cd963cd

# Create new user
RUN useradd -ms /bin/bash luser

# ================================================================================
# Download, extract, install
WORKDIR /hdf5build

#RUN chown -R luser:luser /hdf5build && \
#    chown -R luser:luser /usr/lib/aarch64-linux-gnu 

RUN mkdir ${HDF5_INSTALL_DIR} 
#    chown -R luser:luser ${HDF5_INSTALL_DIR}

#USER luser
RUN git clone https://github.com/HDFGroup/hdf5.git && \
    git -C /hdf5build/hdf5 checkout --detach ${HDF5_COMMIT} && \
    git -C /hdf5build/hdf5 rev-parse HEAD > /hdf5-source-commit

# Build HDF5
WORKDIR /hdf5build/build
RUN cmake -C /hdf5build/hdf5/config/cmake/cacheinit.cmake -G "Unix Makefiles" \
-DHDF5_ALLOW_UNSUPPORTED=ON \
-DHDF5_ENABLE_NONSTANDARD_FEATURE_FLOAT16:BOOL=OFF \
-DHDF5_BUILD_JAVA:BOOL=OFF \
-DHDF5_ENABLE_PARALLEL:BOOL=ON \
-DALLOW_UNSUPPORTED:BOOL=ON \
-DCMAKE_C_COMPILER=/openmpi/bin/mpicc \
-DCMAKE_CXX_COMPILER=/openmpi/bin/mpicxx \
-DCMAKE_Fortran_COMPILER=/openmpi/bin/mpif90 \
-DCMAKE_BUILD_TYPE=${DEPENDENCY_BUILD_TYPE} \
-DCMAKE_INSTALL_PREFIX=${HDF5_INSTALL_DIR} /hdf5build/hdf5 && \
    cmake --build . && \
    make install

# For testing
# ctest . -C --rerun-failed --output-on-failure && \

# Cleanup
#USER root
WORKDIR /
RUN rm -rf /hdf5build

