<?xml version="1.0" encoding="UTF-8" ?>
<svMultiPhysicsFile version="0.1">

<!--
  Phase 1 of 2: prestrain the imaged LV geometry at 10 mmHg. The prestrain is
  a deformation gradient F0 at every Gauss point, from a stress-free
  configuration to the mesh; a displacement u from the mesh gives
  F = (I + Grad u) F0. The geometry never moves. Every Newton iteration starts
  from rest under the full load and composes the displacement it reaches into
  the prestrain, F0 <- (I + Grad u) F0 (the incremental scheme of Gee, Forster
  & Wall 2010), with the tangent of that composed update. Max_iterations 1
  makes every step a single such iteration; more per step are allowed. With
  Pseudo_transient the printed "max update" tends to zero as the state
  converges.

  The load is a dead load on the imaged surface (Follower_pressure_load false).
  The last result_NNN.vtu carries the prestrain as the cell arrays
  Prestrain_F_g<g>, one per Gauss point, which forward.xml reads.

  With Adaptive_time_step the pseudo time step grows by the ratio of
  successive first residuals as the state approaches equilibrium. Once the
  time step is large the residual falls quadratically: it reaches round-off,
  about 1e-14 of its first value, by step 10 of the 20 here. At a fixed dt the
  pseudo-inertia damps every iteration, and the residual falls only by about
  0.9 per step at dt = 1e-2.
-->

<GeneralSimulationParameters>
  <Continue_previous_simulation> 0 </Continue_previous_simulation>
  <Number_of_spatial_dimensions> 3 </Number_of_spatial_dimensions>
  <Number_of_time_steps> 20 </Number_of_time_steps>
  <Time_step_size> 1e-2 </Time_step_size>
  <Spectral_radius_of_infinite_time_step> 0.50 </Spectral_radius_of_infinite_time_step>
  <Searched_file_name_to_trigger_stop> STOP_SIM </Searched_file_name_to_trigger_stop>

  <Save_results_to_VTK_format> 1 </Save_results_to_VTK_format>
  <Name_prefix_of_saved_VTK_files> result </Name_prefix_of_saved_VTK_files>
  <Save_results_in_folder> prestrain </Save_results_in_folder>
  <Increment_in_saving_VTK_files> 1 </Increment_in_saving_VTK_files>
  <Start_saving_after_time_step> 1 </Start_saving_after_time_step>

  <Increment_in_saving_restart_files> 1000 </Increment_in_saving_restart_files>
  <Convert_BIN_to_VTK_format> 0 </Convert_BIN_to_VTK_format>

  <Verbose> 1 </Verbose>
  <Warning> 1 </Warning>
  <Debug> 0 </Debug>
</GeneralSimulationParameters>

<Add_mesh name="msh" >
  <Mesh_file_path> mesh/mesh-complete.mesh.vtu </Mesh_file_path>

  <Add_face name="endo">
      <Face_file_path> mesh/mesh-surfaces/endo.vtp </Face_file_path>
  </Add_face>
  <Add_face name="epi">
      <Face_file_path> mesh/mesh-surfaces/epi.vtp </Face_file_path>
  </Add_face>
  <Add_face name="top">
      <Face_file_path> mesh/mesh-surfaces/top.vtp </Face_file_path>
  </Add_face>

  <Fiber_direction_from_file_cells> mesh/fibersLongCells.vtu </Fiber_direction_from_file_cells>
  <Fiber_direction_from_file_cells> mesh/fibersSheetCells.vtu </Fiber_direction_from_file_cells>

  <Mesh_scale_factor> 100.0 </Mesh_scale_factor> <!-- Convert from m to cm -->
</Add_mesh>

<!-- Using cgs units -->
<Add_equation type="struct" >
   <Coupled> true </Coupled>
   <Min_iterations> 1 </Min_iterations>
   <Max_iterations> 1 </Max_iterations>
   <Tolerance> 1e-10 </Tolerance>

   <Prestrain> true </Prestrain>
   <Pseudo_transient>
     <Adaptive_time_step> true </Adaptive_time_step>
     <Maximum_time_step> 100.0 </Maximum_time_step>
   </Pseudo_transient>

   <Density> 1.0 </Density>                           <!-- g/cm^3 -->
   <Elasticity_modulus> 1.0e6 </Elasticity_modulus>   <!-- dyne/cm^2 -->
   <Poisson_ratio> 0.483333 </Poisson_ratio>

   <Constitutive_model type="HolzapfelOgden">
     <a> 590.0 </a>                                   <!-- dyne/cm^2 -->
     <b> 8.023 </b>                                   <!-- no units -->
     <a4f> 184720.0 </a4f>
     <b4f> 16.026 </b4f>
     <a4s> 24810.0 </a4s>
     <b4s> 11.12 </b4s>
     <afs> 2160.0 </afs>
     <bfs> 11.436 </bfs>
     <k> 100.0 </k>
   </Constitutive_model>

   <Dilational_penalty_model> ST91 </Dilational_penalty_model>
   <Penalty_parameter> 1.0e7 </Penalty_parameter>

   <Output type="Spatial" >
     <Displacement> true </Displacement>
     <Jacobian> true </Jacobian>
     <Stress> true </Stress>
     <Cauchy_stress> true </Cauchy_stress>
     <Def_grad> true </Def_grad>
     <VonMises_stress> true </VonMises_stress>
   </Output>

   <LS type="GMRES" >
      <Linear_algebra type="fsils" >
         <Preconditioner> fsils </Preconditioner>
      </Linear_algebra>
      <Tolerance> 1e-16 </Tolerance>
      <Max_iterations> 1000 </Max_iterations>
      <Krylov_space_dimension> 50 </Krylov_space_dimension>
   </LS>

   <Add_BC name="top" >
      <Type> Dirichlet </Type>
      <Value> 0.0 </Value>
   </Add_BC>

   <!-- 10 mmHg = 13332.2 dyne/cm^2, applied in full from the first step as a
        dead load on the imaged endocardium -->
   <Add_BC name="endo" >
      <Type> Neu </Type>
      <Time_dependence> Steady </Time_dependence>
      <Value> 13332.2 </Value>
      <Follower_pressure_load> false </Follower_pressure_load>
   </Add_BC>

</Add_equation>

</svMultiPhysicsFile>
