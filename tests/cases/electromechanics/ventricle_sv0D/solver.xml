<?xml version="1.0" encoding="UTF-8" ?>
<svMultiPhysicsFile version="0.1">
  <GeneralSimulationParameters>
    <Continue_previous_simulation> 0 </Continue_previous_simulation>
    <Number_of_spatial_dimensions> 3 </Number_of_spatial_dimensions>
    <Number_of_time_steps> 5 </Number_of_time_steps>
    <Time_step_size> 1.0 </Time_step_size> <!-- ms -->
    <Spectral_radius_of_infinite_time_step> 0.50 </Spectral_radius_of_infinite_time_step>
    <Searched_file_name_to_trigger_stop> STOP_SIM </Searched_file_name_to_trigger_stop>

    <Save_results_to_VTK_format> 1 </Save_results_to_VTK_format>
    <Name_prefix_of_saved_VTK_files> result </Name_prefix_of_saved_VTK_files>
    <Increment_in_saving_VTK_files> 1 </Increment_in_saving_VTK_files>
    <Start_saving_after_time_step> 0 </Start_saving_after_time_step>
    <Save_domain_ID_in_every_file> true </Save_domain_ID_in_every_file>

    <Increment_in_saving_restart_files> 200 </Increment_in_saving_restart_files>
    <Convert_BIN_to_VTK_format> 0 </Convert_BIN_to_VTK_format>

    <Verbose> 1 </Verbose>
    <Warning> 1 </Warning>
    <Debug> 0 </Debug>
  </GeneralSimulationParameters>

  <Add_mesh name="msh" >
    <Mesh_file_path> mesh/mesh-complete.mesh.vtu </Mesh_file_path>

    <Add_face name="endo">
      <Face_file_path> mesh/mesh-surfaces/endo.vtp </Face_file_path>
    </Add_face>

    <Add_face name="epi">
      <Face_file_path> mesh/mesh-surfaces/epi.vtp </Face_file_path>
    </Add_face>

    <Add_face name="top">
      <Face_file_path> mesh/mesh-surfaces/top.vtp </Face_file_path>
    </Add_face>

    <Domain> 0 </Domain>

    <Fiber_direction_file_path> mesh/fibersLong.vtu </Fiber_direction_file_path>
    <Fiber_direction_file_path> mesh/fibersSheet.vtu </Fiber_direction_file_path>
  </Add_mesh>

  <Add_equation type="CEP">
    <Coupled> false </Coupled>

    <Min_iterations> 1 </Min_iterations>
    <Max_iterations> 1 </Max_iterations>
    <Tolerance> 1e-10 </Tolerance>

    <!-- Myocardium -->
    <Domain id="0">
      <Electrophysiology_model> TTP </Electrophysiology_model>
      <Time_step_for_integration> 0.1 </Time_step_for_integration> <!-- ms -->

      <!-- One anisotropic value per fiber direction supplied above: along the
           fiber, then along the sheet. -->
      <Isotropic_conductivity> 0.02e-5 </Isotropic_conductivity>
      <Anisotropic_conductivity> 0.1e-5 </Anisotropic_conductivity>
      <Anisotropic_conductivity> 0.0 </Anisotropic_conductivity>

      <Include_xml> ../../cep/ttp_parameters/ttp_epicardium_parameters.xml </Include_xml>

      <TTP>
        <G_Na> 14.838 </G_Na>
        <G_CaL> 3.98E-5 </G_CaL>
        <G_Kr> 0.153 </G_Kr>
      </TTP>

      <!-- Three endocardial activation sites near the apex, 120 degrees apart.
           The spheres are centred inside the cavity so each one overlaps the
           endocardial layer of the wall. -->
      <Stimulus type="Istim" >
        <Amplitude> -36 </Amplitude>
        <Start_time> 0.0 </Start_time>
        <Duration> 2.0 </Duration>
        <Cycle_length> 1000.0 </Cycle_length>

        <Spatial_bounds>
          <Sphere>
            <Center> -0.03 0.022 0.0 </Center>
            <Radius> 0.005 </Radius>
          </Sphere>
        </Spatial_bounds>
      </Stimulus>

      <Stimulus type="Istim" >
        <Amplitude> -36 </Amplitude>
        <Start_time> 0.0 </Start_time>
        <Duration> 2.0 </Duration>
        <Cycle_length> 1000.0 </Cycle_length>

        <Spatial_bounds>
          <Sphere>
            <Center> -0.03 -0.011 0.019 </Center>
            <Radius> 0.005 </Radius>
          </Sphere>
        </Spatial_bounds>
      </Stimulus>

      <Stimulus type="Istim" >
        <Amplitude> -36 </Amplitude>
        <Start_time> 0.0 </Start_time>
        <Duration> 2.0 </Duration>
        <Cycle_length> 1000.0 </Cycle_length>

        <Spatial_bounds>
          <Sphere>
            <Center> -0.03 -0.011 -0.019 </Center>
            <Radius> 0.005 </Radius>
          </Sphere>
        </Spatial_bounds>
      </Stimulus>

      <ODE_solver> RK4 </ODE_solver>
    </Domain>

    <Output type="Spatial" >
      <Membrane_potential> true </Membrane_potential>
      <Ionic_state_variables> true </Ionic_state_variables>
    </Output>

    <LS type="CG" >
      <Linear_algebra type="fsils" >
        <Preconditioner> fsils </Preconditioner>
      </Linear_algebra>
      <Max_iterations> 100 </Max_iterations>
      <Tolerance> 1e-12 </Tolerance>
    </LS>
  </Add_equation>

  <Add_equation type="struct">
    <Coupled> true </Coupled>
    <Min_iterations> 1 </Min_iterations>
    <Max_iterations> 100 </Max_iterations>
    <Tolerance> 1e-9 </Tolerance>

    <Line_search>
      <!-- Minimum decrease is high enough to trigger step rejection in the
           first few iterations, so that line search is tested. A more
           realistic value would be much smaller, e.g., 1e-4. -->
      <Minimum_decrease> 0.25 </Minimum_decrease>
      <Step_reduction_factor> 0.5 </Step_reduction_factor>
      <Minimum_step_length> 1e-2 </Minimum_step_length>
      <Verbose> true </Verbose>
    </Line_search>

    <Domain id="0">
      <Equation> struct </Equation>

      <Density> 1000.0 </Density> <!-- kg/m^3 -->

      <Viscosity model="Potential">
        <Value> 0.1 </Value>
      </Viscosity>

      <!-- Holzapfel & Ogden (2009), Table 1; stresses converted from kPa to MPa.
           The modified-anisotropy variant uses the full (unsplit) anisotropic
           invariants, so the a4s/b4s term acts on the total stretch along
           fibersSheet. -->
      <Constitutive_model type="HolzapfelOgden-ModifiedAnisotropy">
        <a> 59.0e-6 </a>        <!-- MPa -->
        <b> 8.023 </b>
        <a4f> 18472.0e-6 </a4f> <!-- MPa -->
        <b4f> 16.026 </b4f>
        <a4s> 2481.0e-6 </a4s>  <!-- MPa -->
        <b4s> 11.12 </b4s>
        <afs> 216.0e-6 </afs>   <!-- MPa -->
        <bfs> 11.436 </bfs>
        <k> 100.0 </k>
      </Constitutive_model>

      <Active_stress>
        <Model>Regazzoni</Model>

        <Implicit_state_coupling> false </Implicit_state_coupling>
        <Disable_force_strain_rate_feedback> true </Disable_force_strain_rate_feedback>

        <Directional_distribution>
          <Fiber_direction> 1.0 </Fiber_direction>
          <Sheet_direction> 0.0 </Sheet_direction>
          <Sheet_normal_direction> 0.0 </Sheet_normal_direction>
        </Directional_distribution>
        
        <Regazzoni>
          <!-- Sarcomere lengths are in um; they only ever combine with each
             other, since the fiber stretch that maps them to the mesh is
             dimensionless. -->

          <a_XB> 1.0e3 </a_XB> <!-- MPa -->
          
          <!-- These values come from Fedele et al. CMAME (2023), Table A4,
             except that Kd0 and alphaKd are divided by 0.48 to account for the
             calcium rescaling factor that the paper uses. -->
          <SL0> 1.9 </SL0> <!-- um -->
          <Kd0> 0.75e-3 </Kd0> <!-- mM -->
          <alphaKd> -0.434e-3 </alphaKd> <!-- mM/um -->
          <gamma> 30 </gamma> <!-- - -->
          <Koff> 8.0e-3 </Koff> <!-- 1/ms -->
          <Kbasic> 4.0e-3 </Kbasic> <!-- 1/ms -->
          <mu0_fP> 32.225e-3 </mu0_fP> <!-- 1/ms -->
          <mu1_fP> 0.768e-3 </mu1_fP> <!-- 1/ms -->

          <!-- These values come from Regazzoni et al. PLoS Comp Bio (2020) -->
          <Q> 2.0 </Q> <!-- - -->
          <mu> 10.0 </mu> <!-- - -->
          <ru_substep> 2.5e-2 </ru_substep> <!-- ms -->
          <kd_reference_sarcomere_length> 2.15 </kd_reference_sarcomere_length> <!-- um -->
          <r0> 0.13431 </r0> <!-- 1/ms -->
          <alpha> 25.184 </alpha> <!-- - -->
          <LA> 1.25 </LA> <!-- um -->
          <LM> 1.65 </LM> <!-- um -->
          <LB> 0.18 </LB> <!-- um -->
        </Regazzoni>
      </Active_stress>

      <Dilational_penalty_model> Quadratic </Dilational_penalty_model>
      <Penalty_parameter> 1 </Penalty_parameter>
    </Domain>

    <Output type="Spatial" >
      <Displacement> true </Displacement>
      <Velocity> true </Velocity>
      <Jacobian> true </Jacobian>
      <Stress> true </Stress>
      <Strain> true </Strain>
      <VonMises_stress> true </VonMises_stress>
      <Cauchy_stress> true </Cauchy_stress>
      <Def_grad> true </Def_grad>
      <Fiber_direction> true </Fiber_direction>
      <Fiber_stretch> true </Fiber_stretch>
      <Fiber_stretch_rate> true </Fiber_stretch_rate>

      <Active_tension_fibers> true </Active_tension_fibers>
      <Active_tension_sheets> true </Active_tension_sheets>
      <Active_tension_normal> true </Active_tension_normal>
    </Output>

    <LS type="GMRES" >
      <Linear_algebra type="fsils" >
        <Preconditioner> fsils </Preconditioner>
      </Linear_algebra>
      <Tolerance> 1e-10 </Tolerance>
      <Absolute_tolerance> 1e-15 </Absolute_tolerance>
      <Max_iterations> 1 </Max_iterations>
      <Krylov_space_dimension> 500 </Krylov_space_dimension>
    </LS>

    <svZeroDSolver_interface>
      <Coupling_type> implicit </Coupling_type>
      <Configuration_file> svzerod_3Dcoupling.json </Configuration_file>
      <Shared_library> ../../../../svZeroDSolver/build/src/interface/libsvzero_interface.dylib </Shared_library>
      <Initial_flows> 0.0 </Initial_flows>
      <Initial_pressures> 0.0 </Initial_pressures>

      <Finite_difference_absolute_perturbation> 1e-14 </Finite_difference_absolute_perturbation>
      <Finite_difference_relative_perturbation> 1e-10 </Finite_difference_relative_perturbation>
    </svZeroDSolver_interface>

    <Add_BC name="epi" >
      <Type> Robin </Type>
      <Stiffness> 100.0 </Stiffness> <!-- MPa/m -->
      <Damping> 5.0 </Damping> <!-- MPa*ms/m -->
      <Apply_along_normal_direction> 1 </Apply_along_normal_direction>
    </Add_BC>

    <Add_BC name="top" >
      <Type> Robin </Type>
      <Stiffness> 0.1 </Stiffness> <!-- MPa/m -->
      <Damping> 5.0 </Damping> <!-- MPa*ms/m -->
    </Add_BC>

    <Add_BC name="endo" >
      <Type> Neu </Type>
      <Time_dependence> Coupled </Time_dependence>
      <Follower_pressure_load> true </Follower_pressure_load>
      <Coupling_interface>
        <svZeroDSolver_block> LV_IN </svZeroDSolver_block>
        <Chamber_cap_surface> mesh/mesh-surfaces/endo_cap.vtp </Chamber_cap_surface>
        <Relax_factor> 1.0 </Relax_factor>
      </Coupling_interface>
    </Add_BC>
  </Add_equation>
</svMultiPhysicsFile>
