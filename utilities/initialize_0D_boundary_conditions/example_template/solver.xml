<svMultiPhysicsFile version="1.0">
  <GeneralSimulationParameters>
    <Continue_previous_simulation>false</Continue_previous_simulation>
    <Save_results_in_folder>results</Save_results_in_folder>

    <Number_of_spatial_dimensions>3</Number_of_spatial_dimensions>
    <Number_of_time_steps>4000</Number_of_time_steps>
    <Time_step_size>0.001</Time_step_size>
    <Spectral_radius_of_infinite_time_step>0.5</Spectral_radius_of_infinite_time_step>

    <Save_results_to_VTK_format>true</Save_results_to_VTK_format>
    <Name_prefix_of_saved_VTK_files>result</Name_prefix_of_saved_VTK_files>
    <Increment_in_saving_VTK_files>100</Increment_in_saving_VTK_files>
  </GeneralSimulationParameters>

  <Add_mesh name="fluid_mesh">
    <Mesh_file_path>mesh-complete/mesh-complete.mesh.vtu</Mesh_file_path>

    <Add_face name="inlet">
      <Face_file_path>mesh-complete/mesh-surfaces/inlet.vtp</Face_file_path>
    </Add_face>
    <Add_face name="wall">
      <Face_file_path>mesh-complete/mesh-surfaces/wall.vtp</Face_file_path>
    </Add_face>
    <Add_face name="Brachiocephalic">
      <Face_file_path>mesh-complete/mesh-surfaces/Brachiocephalic.vtp</Face_file_path>
    </Add_face>
    <Add_face name="left_common_carotid">
      <Face_file_path>mesh-complete/mesh-surfaces/left_common_carotid.vtp</Face_file_path>
    </Add_face>
    <Add_face name="left_subclavian">
      <Face_file_path>mesh-complete/mesh-surfaces/left_subclavian.vtp</Face_file_path>
    </Add_face>
    <Add_face name="lower_outlet">
      <Face_file_path>mesh-complete/mesh-surfaces/lower_outlet.vtp</Face_file_path>
    </Add_face>

    <Initial_pressures_file_path>num-procs/result_6000.vtu</Initial_pressures_file_path>
    <Initial_velocities_file_path>num-procs/result_6000.vtu</Initial_velocities_file_path>
  </Add_mesh>

  <Add_equation type="fluid">
    <Coupled>true</Coupled>
    <Min_iterations>3</Min_iterations>
    <Max_iterations>12</Max_iterations>
    <Tolerance>1e-5</Tolerance>
    <Backflow_stabilization_coefficient>0.2</Backflow_stabilization_coefficient>
    <Density>1.06</Density>
    <Viscosity model="Constant">
      <Value>0.04</Value>
    </Viscosity>

    <LS type="NS">
      <Linear_algebra type="fsils">
        <Preconditioner>fsils</Preconditioner>
      </Linear_algebra>
      <Max_iterations>10</Max_iterations>
      <NS_GM_max_iterations>200</NS_GM_max_iterations>
      <NS_CG_max_iterations>500</NS_CG_max_iterations>
      <Tolerance>0.4</Tolerance>
      <NS_GM_tolerance>0.01</NS_GM_tolerance>
      <NS_CG_tolerance>0.2</NS_CG_tolerance>
      <Krylov_space_dimension>50</Krylov_space_dimension>
    </LS>

    <svZeroDSolver_interface>
      <Coupling_type>semi-implicit</Coupling_type>
      <Configuration_file>svzerod_3Dcoupling.json</Configuration_file>
      <Shared_library>/path/to/libsvzero_interface.so</Shared_library>
    </svZeroDSolver_interface>

    <Output type="Spatial">
      <Pressure>true</Pressure>
      <Velocity>true</Velocity>
    </Output>

    <Output type="Boundary_integral">
      <Velocity>true</Velocity>
      <Pressure>true</Pressure>
      <WSS>true</WSS>
    </Output>

    <Add_BC name="inlet">
      <Type>Dirichlet</Type>
      <Time_dependence>Unsteady</Time_dependence>
      <Temporal_values_file_path>inlet.flow</Temporal_values_file_path>
      <Profile>Parabolic</Profile>
      <Impose_flux>true</Impose_flux>
    </Add_BC>

    <Add_BC name="wall">
      <Type>Dirichlet</Type>
      <Time_dependence>Steady</Time_dependence>
      <Value>0</Value>
    </Add_BC>

    <Add_BC name="Brachiocephalic">
      <Type>Neu</Type>
      <Time_dependence>Coupled</Time_dependence>
      <Coupling_interface>
        <svZeroDSolver_block>RCR_coupling_brachiocephalic</svZeroDSolver_block>
      </Coupling_interface>
    </Add_BC>

    <Add_BC name="left_common_carotid">
      <Type>Neu</Type>
      <Time_dependence>Coupled</Time_dependence>
      <Coupling_interface>
        <svZeroDSolver_block>RCR_coupling_left_common_carotid</svZeroDSolver_block>
      </Coupling_interface>
    </Add_BC>

    <Add_BC name="left_subclavian">
      <Type>Neu</Type>
      <Time_dependence>Coupled</Time_dependence>
      <Coupling_interface>
        <svZeroDSolver_block>RCR_coupling_left_subclavian</svZeroDSolver_block>
      </Coupling_interface>
    </Add_BC>

    <Add_BC name="lower_outlet">
      <Type>Neu</Type>
      <Time_dependence>Coupled</Time_dependence>
      <Coupling_interface>
        <svZeroDSolver_block>RCR_coupling_lower_outlet</svZeroDSolver_block>
      </Coupling_interface>
    </Add_BC>
  </Add_equation>
</svMultiPhysicsFile>

